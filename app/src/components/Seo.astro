---
import { slugify } from "./heroUtils";

interface Props {
  title: string;
  description?: string;
  authors?: string[];
  published?: string;
  modified?: string;
  tags?: string[];
  image?: string; // Preferred absolute URL
}

const {
  title,
  description = "",
  authors = [],
  published,
  modified,
  tags = [],
  image,
} = Astro.props as Props;

const url = Astro.url?.toString?.() ?? "";
const site = (Astro.site ? String(Astro.site) : "") as string;

// Build base URL: prefer Astro.site, fallback to origin from Astro.url
const baseUrl = site || (Astro.url ? `${Astro.url.protocol}//${Astro.url.host}` : "");

const ogImage =
  image && image.length > 0
    ? image.startsWith("http")
      ? image
      : baseUrl
        ? new URL(image, baseUrl).toString()
        : image
    : undefined;

// Google Scholar / Highwire metadata. Keep the bibliographic title on one
// logical line and link the HTML article to the co-located canonical PDF.
const citationTitle = String(title || "")
  .replace(/\s+/g, " ")
  .trim();

const citationPublicationDate = (() => {
  if (!published) return undefined;
  const raw = String(published).trim();

  const iso = raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (iso) return `${iso[1]}/${Number(iso[2])}/${Number(iso[3])}`;

  const parsed = new Date(raw);
  if (!Number.isNaN(parsed.getTime())) {
    return `${parsed.getUTCFullYear()}/${parsed.getUTCMonth() + 1}/${parsed.getUTCDate()}`;
  }

  const year = raw.match(/\b(19|20)\d{2}\b/);
  return year ? year[0] : undefined;
})();

const citationPdfUrl = url
  ? new URL(
      `${slugify(citationTitle)}.pdf`,
      url.endsWith("/") ? url : `${url}/`,
    ).toString()
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description || undefined,
  datePublished: published || undefined,
  dateModified: modified || published || undefined,
  author: authors.map((name) => ({ "@type": "Person", name })),
  publisher: {
    "@type": "Organization",
    name: "Hugging Face",
    url: "https://huggingface.co",
  },
  keywords: tags.length ? tags.join(", ") : undefined,
  mainEntityOfPage: url || undefined,
  image: ogImage ? [ogImage] : undefined,
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />

<!-- Google Scholar / Highwire Press bibliographic metadata -->
<meta name="citation_title" content={citationTitle} />
{authors.map((a) => <meta name="citation_author" content={a} />)}
{citationPublicationDate && (
  <meta name="citation_publication_date" content={citationPublicationDate} />
)}
{citationPdfUrl && <meta name="citation_pdf_url" content={citationPdfUrl} />}

<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={url} />
<meta property="og:locale" content="en_US" />
{baseUrl && <meta property="og:site_name" content={title} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:alt" content={title} />}
{published && <meta property="article:published_time" content={published} />}
{modified && <meta property="article:modified_time" content={modified} />}
{authors.map((a) => <meta property="article:author" content={a} />)}

<meta
  name="twitter:card"
  content={ogImage ? "summary_large_image" : "summary"}
/>
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && <meta name="twitter:image:alt" content={title} />}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
